{
  "components": {
    "schemas": {
      "DistillInput": {
        "additionalProperties": false,
        "description": "Select the maximum depth for the distilled rule.",
        "properties": {
          "max_depth": {
            "default": 4,
            "minimum": 1.0,
            "title": "Max Depth",
            "type": "integer"
          }
        },
        "title": "DistillInput",
        "type": "object"
      },
      "ExclusionInput": {
        "additionalProperties": false,
        "description": "Whether a source feature is omitted from teacher and rule fitting.",
        "properties": {
          "excluded": {
            "title": "Excluded",
            "type": "boolean"
          }
        },
        "required": [
          "excluded"
        ],
        "title": "ExclusionInput",
        "type": "object"
      },
      "ExportFormat": {
        "enum": [
          "sql",
          "dbt",
          "python",
          "json"
        ],
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LabelInput": {
        "additionalProperties": false,
        "description": "Set or clear one answer in the selected labelling mode.",
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "mode": {
            "default": "human",
            "enum": [
              "human",
              "eval"
            ],
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "title": "LabelInput",
        "type": "object"
      },
      "TargetInput": {
        "additionalProperties": false,
        "description": "Declare a target and its class vocabulary without importing source answers.",
        "properties": {
          "classes": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 2,
            "title": "Classes",
            "type": "array"
          },
          "target": {
            "minLength": 1,
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "target",
          "classes"
        ],
        "title": "TargetInput",
        "type": "object"
      },
      "ThresholdInput": {
        "additionalProperties": false,
        "description": "Minimum probability or leaf purity required for an answer.",
        "properties": {
          "threshold": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Threshold",
            "type": "number"
          }
        },
        "required": [
          "threshold"
        ],
        "title": "ThresholdInput",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
